function doGet(e){const p=(e&&e.parameter)||{};try{let result;switch(String(p.action||'dashboard')){case 'health':result={success:true,message:'Backend online',spreadsheetId:SPREADSHEET_ID};break;case 'setupSheets':result={success:true,message:setupSheets()};break;case 'saveDSR':result=saveDSR_(payload_(p));break;case 'getDSR':result=getDSR_(p);break;case 'dashboard':result=dashboard_();break;default:result={success:false,message:'Unknown action: '+p.action};}return output_(result,p.callback)}catch(err){return output_({success:false,message:String(err&&err.message||err)},p.callback)}}
function payload_(p){return p.data?JSON.parse(p.data):p}
function output_(data,callback){const json=JSON.stringify(data);if(callback&&/^[A-Za-z_$][\w$]*$/.test(callback))return ContentService.createTextOutput(callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON)}
function ss_(){
  const id = String(SPREADSHEET_ID || '').trim();
  if (!id || id === 'PUT_SPREADSHEET_ID_HERE' || id.includes('script.google.com')) {
    throw new Error('Set the Google Spreadsheet ID (not the Apps Script URL) in Code.gs');
  }
  return SpreadsheetApp.openById(id);
}
function ensureSheet_(name,headers){const ss=ss_();let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers])}else{const current=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getDisplayValues()[0];headers.forEach(h=>{if(!current.includes(h)){sh.getRange(1,sh.getLastColumn()+1).setValue(h)}})}const last=sh.getLastColumn();sh.getRange(1,1,1,last).setBackground('#183553').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);sh.setFrozenRows(1);sh.getDataRange().setVerticalAlignment('top');return sh}
function setupSheets(){const dsr=ensureSheet_(DSR_SHEET,DSR_HEADERS),ev=ensureSheet_(EVENT_SHEET,EVENT_HEADERS);dsr.setColumnWidth(1,180);dsr.setColumnWidth(2,120);dsr.setColumnWidth(8,420);dsr.setColumnWidth(13,360);dsr.setColumnWidth(26,300);ev.setColumnWidth(1,120);ev.setColumnWidth(2,180);ev.setColumnWidth(4,220);ev.setColumnWidth(6,160);ev.setColumnWidth(7,160);ev.setColumnWidth(10,180);return 'DAILY_SECURITY_REPORTS and DSR_EVENT_FUNCTIONS sheets/headers are ready.'}
function dateISO_(v){if(v instanceof Date)return Utilities.formatDate(v,TZ,'yyyy-MM-dd');const s=String(v||'').trim();if(/^\d{2}-\d{2}-\d{4}$/.test(s)){const a=s.split('-');return a[2]+'-'+a[1]+'-'+a[0]}return s.slice(0,10)}
function numOrBlank_(v){return v===undefined||v===null||v===''?'':v}
function parseJsonArray_(v){if(Array.isArray(v))return v;if(!v)return [];try{const x=JSON.parse(v);return Array.isArray(x)?x:[]}catch(e){return []}}
function saveEventRows_(date,id,events,now){const sh=ensureSheet_(EVENT_SHEET,EVENT_HEADERS);const vals=sh.getDataRange().getValues();const headers=vals[0].map(String),dateIdx=headers.indexOf('Report Date'),idIdx=headers.indexOf('DSR ID');for(let i=vals.length-1;i>=1;i--){if(String(vals[i][idIdx])===String(id)||dateISO_(vals[i][dateIdx])===date)sh.deleteRow(i+1)}events.forEach((e,i)=>sh.appendRow([date,id,i+1,e.groupName||'',numOrBlank_(e.functionPax),e.venue||'',e.functionType||'',numOrBlank_(e.platesUsed),e.differencePlates||'',e.billPayee||'',now]))}
function saveDSR_(d){const sh=ensureSheet_(DSR_SHEET,DSR_HEADERS),date=dateISO_(d.reportDate||d.date);if(!date)throw new Error('Report Date is required.');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const data=sh.getDataRange().getValues(),headers=data[0].map(String),dateCol=headers.indexOf('Report Date'),idCol=headers.indexOf('ID');let rowNum=-1,id=String(d.id||'DSR-'+date);for(let i=1;i<data.length;i++){if((d.id&&String(data[i][idCol])===String(d.id))||dateISO_(data[i][dateCol])===date){rowNum=i+1;id=String(data[i][idCol]||id);break}}const now=new Date(),events=parseJsonArray_(d.events),values={ID:id,'Report Date':date,'Report Sent On Date':dateISO_(d.reportSentDate||date),'Prepared By':d.preparedBy||'','Morning Shift Incharge':d.morningIncharge||'','Afternoon Shift Incharge':d.afternoonIncharge||'','Night Shift Incharge':d.nightIncharge||'','Today Night MOD':d.nightMOD||'','Security Round Observations':d.observations||'','Hotel Rooms':numOrBlank_(d.hotelRooms),'Hotel Room Pax':numOrBlank_(d.hotelPax),'Brijnest Rooms':numOrBlank_(d.brijnestRooms),'Brijnest Pax':numOrBlank_(d.brijnestPax),'Event / Function Details JSON':JSON.stringify(events),'Breakfast Pax':numOrBlank_(d.breakfastPax),'Lunch Pax':numOrBlank_(d.lunchPax),'Dinner Pax':numOrBlank_(d.dinnerPax),'Gas Cylinders':'112','Actual Breakfast Menu':d.breakfastMenu||'','Café Lunch Waste (kg)':numOrBlank_(d.lunchWaste),'Café Dinner Waste (kg)':numOrBlank_(d.dinnerWaste),'Main Kitchen Waste (kg)':numOrBlank_(d.kitchenWaste),'Staff Kitchen Waste (kg)':numOrBlank_(d.staffKitchenWaste),'Main Porch Vehicles':numOrBlank_(d.porch),'MDP Parking Vehicles':numOrBlank_(d.mdp),'KTP Parking Vehicles':numOrBlank_(d.ktp),'Photo Captions JSON':JSON.stringify(parseJsonArray_(d.photoCaptions)),'Updated At':now};if(rowNum<0)values['Created At']=now;const row=headers.map(h=>Object.prototype.hasOwnProperty.call(values,h)?values[h]:'');if(rowNum>0)sh.getRange(rowNum,1,1,headers.length).setValues([row]);else sh.appendRow(row);saveEventRows_(date,id,events,now);return {success:true,id:id,reportDate:date,eventCount:events.length,message:rowNum>0?'Daily Security Report updated':'Daily Security Report saved'}}finally{lock.releaseLock()}}
function readRows_(){const sh=ensureSheet_(DSR_SHEET,DSR_HEADERS),values=sh.getDataRange().getValues();if(values.length<2)return [];const headers=values[0].map(String);return values.slice(1).filter(row=>row.some(v=>v!==''&&v!==null)).map(row=>{const o={};headers.forEach((h,i)=>{let v=row[i];if(v instanceof Date)v=Utilities.formatDate(v,TZ,'yyyy-MM-dd HH:mm:ss');o[h]=v});return o})}
function getDSR_(p){const period=String(p.period||'all').toLowerCase(),selected=dateISO_(p.date||Utilities.formatDate(new Date(),TZ,'yyyy-MM-dd'));const rows=readRows_().filter(r=>{const d=dateISO_(r['Report Date']);if(period==='day')return d===selected;if(period==='month')return d.slice(0,7)===selected.slice(0,7);if(period==='year')return d.slice(0,4)===selected.slice(0,4);return true}).map(r=>({id:r.ID,reportDate:dateISO_(r['Report Date']),reportSentDate:dateISO_(r['Report Sent On Date']||r['Report Date']),preparedBy:r['Prepared By'],morningIncharge:r['Morning Shift Incharge'],afternoonIncharge:r['Afternoon Shift Incharge'],nightIncharge:r['Night Shift Incharge'],nightMOD:r['Today Night MOD'],observations:r['Security Round Observations'],hotelRooms:r['Hotel Rooms'],hotelPax:r['Hotel Room Pax'],brijnestRooms:r['Brijnest Rooms'],brijnestPax:r['Brijnest Pax'],events:r['Event / Function Details JSON']||'[]',breakfastPax:r['Breakfast Pax'],lunchPax:r['Lunch Pax'],dinnerPax:r['Dinner Pax'],gasCylinders:r['Gas Cylinders'],breakfastMenu:r['Actual Breakfast Menu'],lunchWaste:r['Café Lunch Waste (kg)'],dinnerWaste:r['Café Dinner Waste (kg)'],kitchenWaste:r['Main Kitchen Waste (kg)'],staffKitchenWaste:r['Staff Kitchen Waste (kg)'],porch:r['Main Porch Vehicles'],mdp:r['MDP Parking Vehicles'],ktp:r['KTP Parking Vehicles'],photoCaptions:r['Photo Captions JSON']||'[]'}));return {success:true,count:rows.length,rows:rows}}
function dashboard_(){const x=getDSR_({period:'all'});return {success:true,dsrCount:x.count,rows:x.rows.slice(-10).reverse()}}
function testConnection(){const s=ss_();return {success:true,spreadsheetName:s.getName(),spreadsheetId:s.getId(),sheetNames:s.getSheets().map(x=>x.getName())}}
